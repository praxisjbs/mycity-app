{
  "name": "mycity-app",
  "version": "0.1.0",
  "private": true,
  "description": "MyCity App ERP: Express API, worker, and the wire contract. Built by JBS Praxis.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci": "node scripts/ci-local.js",
    "ci:list": "node scripts/ci-local.js --list",
    "lint": "eslint --max-warnings 0 .",
    "test": "jest",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:seed": "node scripts/db/seed.js",
    "db:create-admin": "node scripts/db/create-admin.js",
    "gen:contract": "node scripts/gen/contract.js",
    "gen:env": "node scripts/gen/env-example.js",
    "check:pagination": "node scripts/check/pagination.js",
    "check:progress": "node scripts/check/progress.js",
    "check:guides": "node scripts/check/guides.js",
    "check:readme-map": "node scripts/check/readme-map.js",
    "check:codeowners": "node scripts/check/codeowners.js"
  },
  "dependencies": {
    "@mycity/contract": "file:packages/contract",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^15.0.12",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
