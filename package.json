{
  "name": "mycity-app",
  "version": "0.1.0",
  "private": true,
  "description": "MyCity App ERP: Express API, worker, and the wire contract. Built by JBS Praxis.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "packages/*",
    "app",
    "public-app"
  ],
  "scripts": {
    "ci": "node scripts/ci-local.js",
    "ci:list": "node scripts/ci-local.js --list",
    "lint": "eslint --max-warnings 0 .",
    "test": "jest",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:seed": "node scripts/db/seed.js",
    "db:create-admin": "node scripts/db/create-admin.js",
    "gen:contract": "node scripts/gen/contract.js",
    "gen:env": "node scripts/gen/env-example.js",
    "gen:components": "node scripts/gen/components.js",
    "gen:ai-catalogue": "node scripts/gen/ai-catalogue.js",
    "new:component": "node scripts/new-component.js",
    "new:screen": "node scripts/new-screen.js",
    "guide:shots": "node scripts/guide/shoot.js",
    "check:pagination": "node scripts/check/pagination.js",
    "check:five-second": "node scripts/check/five-second.js",
    "check:two-shells": "node scripts/check/two-shells.js",
    "check:forms": "node scripts/check/forms.js",
    "check:native-ui": "node scripts/check/native-ui.js",
    "check:dashes": "node scripts/check/dashes.js",
    "check:progress": "node scripts/check/progress.js",
    "check:guides": "node scripts/check/guides.js",
    "check:readme-map": "node scripts/check/readme-map.js",
    "check:codeowners": "node scripts/check/codeowners.js",
    "gallery": "npm -w @mycity/ui run gallery",
    "fe:typecheck": "npm run typecheck -w @mycity/ui -w @mycity/app -w @mycity/public-app",
    "fe:lint": "npm run lint -w @mycity/ui -w @mycity/app -w @mycity/public-app",
    "fe:test": "node scripts/fe-test.js",
    "fe:build": "npm run build -w @mycity/ui -w @mycity/app -w @mycity/public-app",
    "check:schedulers": "node scripts/check/schedulers.js",
    "health:brief": "node scripts/ops/health-brief.js"
  },
  "dependencies": {
    "@mycity/contract": "file:packages/contract",
    "@simplewebauthn/server": "^13.3.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.5",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^8.0.2",
    "imapflow": "^1.0.191",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.4",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "5.6.205",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "playwright": "1.56.1",
    "smtp-server": "^3.13.8",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "5.9.3"
  }
}
