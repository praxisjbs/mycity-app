# MyCity App: environment variables.
# GENERATED by scripts/gen/env-example.js from src/config/env.js. Do not edit; run `npm run gen:env`.
#
# Local: copy to .env and fill what you need; empty secrets use development values.
# Servers: /srv/mycity/<prod|stg>/shared/.env, mode 600. Every secret is required there,
# and the API refuses to start without it.

# ---- Runtime -----------------------------------------------------
# Which environment this process is. Drives the markers, the seed guard and the server checks below.
APP_ENV=development
# Must be production on staging and production servers.
NODE_ENV=development
# API listen port. Staging and production run on different ports behind the proxy.
PORT=8080
# Pino log level.
LOG_LEVEL=info
# Proxies in front of Node. 1 behind the hosting panel proxy; 0 only when Node is hit directly.
TRUST_PROXY_HOPS=1
# Commit of the running release. Written by the deploy; empty on a laptop.
BUILD_SHA=
# When the release was built (ISO). Written by the deploy.
BUILD_TIME=

# ---- Origins -----------------------------------------------------
# The staff app origin. CORS for /api/v1 and Socket.io allows this origin only. On servers: https://hub.mycityapp.io
STAFF_ORIGIN=http://localhost:5173
# The public site origin. CORS for /api/public/v1 allows this origin only, without credentials. On servers: https://go.mycityapp.io
PUBLIC_ORIGIN=http://localhost:5174
# Development only: extra comma-separated origins allowed on both surfaces. Ignored on servers.
DEV_EXTRA_ORIGINS=

# ---- Database ----------------------------------------------------
# Optional. postgres://user:pass@host:port/db. When set it wins over the DB_* values.
DATABASE_URL=
# Postgres host.
DB_HOST=127.0.0.1
# Postgres port.
DB_PORT=5432
# mycity_prod on production, mycity_stg on staging (checked at boot).
DB_NAME=mycity_dev
# The environment's own app role. Never a superuser.
DB_USER=mycity_dev
# Required on servers. SECRET.
DB_PASSWORD=
# TLS to Postgres. Off for a local socket on the same server.
DB_SSL=false
# Connections in the API process's pool. 20 on production, 10 on staging.
DB_POOL_MAX=20
# Connections in the worker process's pool. 10 on production, 5 on staging.
WORKER_DB_POOL_MAX=10
# A statement running longer than this is cancelled by Postgres.
DB_STATEMENT_TIMEOUT_MS=30000
# Queries slower than this are logged at warn.
DB_SLOW_QUERY_MS=500

# ---- Redis -------------------------------------------------------
# redis://[:password@]host:port/db. Production uses db 0, staging db 1 (checked at boot); local defaults to db 2.
REDIS_URL=redis://127.0.0.1:6379/2

# ---- Sign-in -----------------------------------------------------
# Signs access tokens. At least 32 characters; different from the refresh secret. SECRET.
JWT_ACCESS_SECRET=
# Signs refresh tokens. At least 32 characters. SECRET.
JWT_REFRESH_SECRET=
# Access token life in minutes.
ACCESS_TOKEN_MIN=15
# A session ends this many minutes after sign-in, whatever the person is doing; the screen locks and they sign in again. Every token ends with its session.
SESSION_MAX_AGE_MIN=120
# A session with no refresh for this many minutes (a closed tab, a sleeping laptop) ends on its return.
SESSION_INACTIVITY_MIN=30
# Adding a new way to sign in (a passkey, a PIN) needs no password only this soon after signing in.
CREDENTIAL_ENROL_WINDOW_MIN=15
# The shortest new password allowed. Settings, Security may raise it, never lower it; the session and idle limits above are floors in the same way.
PASSWORD_MIN_LENGTH=8
# Refuse a new password found in known breaches (Have I Been Pwned range API: only 5 characters of a hash leave the server). Allows the password if the service is unreachable.
PASSWORD_BREACH_CHECK=true
# Passkeys belong to this host (the relying party ID): hub.mycityapp.io, or hub.staging.mycityapp.io on staging. Empty: the host of WEBAUTHN_ORIGIN. On servers: hub.mycityapp.io
WEBAUTHN_RP_ID=
# The page origin a passkey must be used from, https on servers: https://hub.mycityapp.io, or https://hub.staging.mycityapp.io on staging. Empty: STAFF_ORIGIN. On servers: https://hub.mycityapp.io
WEBAUTHN_ORIGIN=

# ---- Secrets -----------------------------------------------------
# 64 hex characters (32 bytes). AES-256-GCM key for integration_secret: mailbox passwords and every key and password on Settings, Integrations. It protects them, so it stays here, never on that page. SECRET.
ENCRYPTION_KEY=

# ---- Files -------------------------------------------------------
# Private media root for this environment. On servers: /srv/mycity/<prod|stg>/media
MEDIA_ROOT=./media
# The staff app build the API serves on the staff host. Relative to the release root.
APP_DIST_DIR=app/dist
# The public site build the API serves on the public host. Relative to the release root.
PUBLIC_APP_DIST_DIR=public-app/dist

# ---- Media tools -------------------------------------------------
# Chromium for PDFs. Empty: the usual install paths are tried (/usr/bin/chromium, ...). On servers: /usr/bin/chromium
CHROMIUM_PATH=
# ffmpeg, for voice notes and video.
FFMPEG_PATH=ffmpeg
# ffprobe, for media duration and size.
FFPROBE_PATH=ffprobe
# clamd's unix socket, for scanning files strangers upload. Empty: CLAMD_HOST and CLAMD_PORT. On servers: /run/clamav/clamd.ctl
CLAMD_SOCKET=
# clamd TCP host, when no socket is set.
CLAMD_HOST=127.0.0.1
# clamd TCP port, when no socket is set.
CLAMD_PORT=3310

# ---- Mail --------------------------------------------------------
# SMTP server for system mail. Fallback for Settings, Integrations, System Sender: used until a sender is saved there. With neither, mail is captured on a laptop and held on a server.
SMTP_HOST=
# 587 with STARTTLS, or 465 with SMTP_SECURE. Fallback, as SMTP_HOST.
SMTP_PORT=587
# TLS from the first byte (port 465). Off: STARTTLS is required. Fallback, as SMTP_HOST.
SMTP_SECURE=false
# SMTP account. Fallback, as SMTP_HOST.
SMTP_USER=
# SMTP password. Fallback, as SMTP_HOST; Settings, Integrations keeps it encrypted instead. SECRET.
SMTP_PASSWORD=
# From address for system mail. Its domain must pass SPF, DKIM and DMARC (services/mail/deliverability). Fallback, as SMTP_HOST.
MAIL_FROM=MyCity App <no-reply@mycityapp.io>
# Optional Reply-To for system mail (the support inbox). Fallback, as SMTP_HOST.
MAIL_REPLY_TO=
# System mail recipients per rolling hour (services/mail/pace.js); 0 sends unpaced. Production and staging share the mailbox's limit: 40 and 10 of the plan's 50. Fallback, as SMTP_HOST.
MAIL_SEND_PER_HOUR=0
# Comma-separated domains whose mailboxes are on the SMTP server itself, behind the host's spam-filter MX. System mail to them is delivered there; every other domain is still route-checked. Empty: none. Fallback, as SMTP_HOST.
SMTP_LOCAL_DOMAINS=mycityapp.io
# Comma-separated DNS blocklists the deliverability check looks the sending IP up in. Empty: Spamhaus ZEN, SpamCop and Barracuda. On servers: zen.spamhaus.org,bl.spamcop.net
MAIL_RBL_HOSTS=

# ---- Mailbox -----------------------------------------------------
# IMAP host for every mailbox. Empty: the address's own domain, which is MyCity's cPanel host and its certificate name. The MAILBOX_* values are the fallback for Settings, Integrations, Staff Mail Server: used until it is saved there.
MAILBOX_IMAP_HOST=
# IMAP port (993, TLS). Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_IMAP_PORT=993
# SMTP host for every mailbox. Empty: the address's own domain. Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_SMTP_HOST=
# SMTP port (465, TLS). Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_SMTP_PORT=465
# TLS to the mail host, with the certificate checked against its name. Off only for a local test server; Settings, Integrations never turns it off.
MAILBOX_TLS=true
# Recipients one mailbox may send to in an hour; the send queue waits beyond it (the host's plan allows 50). Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_SEND_PER_HOUR=50
# Minutes between syncs of every connected mailbox, the safety net behind IMAP IDLE. Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_SYNC_EVERY_MIN=2
# Mailboxes held open on IMAP IDLE by the worker, so new mail arrives the moment it lands instead of at the next sync. The host allows 30 connections per IP for production and staging together. Empty: 24 on production, 4 on staging, 0 on laptops and in tests. Fallback, as MAILBOX_IMAP_HOST.
MAILBOX_IDLE_MAX=

# ---- Web push ----------------------------------------------------
# Who push services contact about this server's pushes: a mailto: or https: address. Fallback for Settings, Integrations, Web Push: used until a contact is saved there.
VAPID_SUBJECT=mailto:jbspraxisllc@gmail.com
# Optional. The VAPID public key (base64url). A pair kept in the database (made by the app, or by Replace Keys on Settings, Integrations) wins over it; with neither, the app makes one. Set both keys or neither.
VAPID_PUBLIC_KEY=
# Optional. The VAPID private key (base64url), with VAPID_PUBLIC_KEY. A pair kept in the database wins over it. SECRET.
VAPID_PRIVATE_KEY=

# ---- AI ----------------------------------------------------------
# Gemini API key. Fallback for Settings, Integrations, Gemini: used until a key is saved there. With neither, AI calls return the stub's placeholder (vendor "stub"), are recorded, and cost nothing. SECRET.
GEMINI_API_KEY=
# The Gemini model every AI call uses unless ai_setting names another.
GEMINI_MODEL=gemini-2.5-flash
# How long one AI call may take before it is abandoned.
AI_REQUEST_TIMEOUT_MS=60000
# Ceiling on one answer's length, in tokens.
AI_MAX_OUTPUT_TOKENS=4096
# Naira per million input tokens, for the spend ledger and the monthly cap. Default: Gemini 2.5 Flash list price at about 1,500 naira to the dollar. ai_setting overrides it.
AI_INPUT_NGN_PER_MILLION=450.00
# Naira per million output tokens. ai_setting overrides it.
AI_OUTPUT_NGN_PER_MILLION=3750.00

# ---- Maps --------------------------------------------------------
# Geoapify API key for the address search behind every location field. Fallback for Settings, Integrations, Geoapify: used until a key is saved there. With neither, the search answers 503 and the fields take a typed address and coordinates. SECRET.
GEOAPIFY_API_KEY=

# ---- Rate limits -------------------------------------------------
# Staff API requests per user per minute.
RATE_LIMIT_STAFF_PER_MIN=600
# Public API requests per IP per minute.
RATE_LIMIT_PUBLIC_PER_MIN=120
# Public API writes (applications, uploads) per IP per minute.
RATE_LIMIT_PUBLIC_WRITES_PER_MIN=20

# ---- Observability -----------------------------------------------
# Slack or Google Chat webhook for alerts (5xx, backups, uptime). Empty: not used. SECRET.
ALERT_WEBHOOK_URL=
# WhatsApp alert links, one per person, separated by spaces; each a gateway link with {text} where the message goes (docs/runbooks/monitoring.md §2). Empty: not used. SECRET.
ALERT_WHATSAPP_URLS=
# Who the server's health watch mails the Status brief to when something is down (scripts/ops/health-brief.js, docs/runbooks/system-health.md). Addresses separated by commas or spaces. Empty: it mails nobody.
HEALTH_ALERT_TO=intelligence@jbspraxis.com
# Who the health watch copies on that mail. Addresses separated by commas or spaces.
HEALTH_ALERT_CC=tomblakeasaah@gmail.com, praxisjbs@gmail.com
# Bearer token for GET /api/metrics. Empty: the endpoint does not exist. SECRET.
METRICS_TOKEN=
