{
  "name": "@mycity/public-app",
  "version": "0.1.0",
  "private": true,
  "description": "MyCity App public site (go.mycityapp.io): careers, applying, assessments, offer signing, document verification. React, Vite, Tailwind. No PWA.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mycity/ui": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
