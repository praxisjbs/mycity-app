# MyCity API (production) · SYSTEM_ARCHITECTURE §1, §2.
# Installed by ops/provision/provision.sh into /etc/systemd/system/ and enabled; deploy-gate
# starts and restarts it; until the first release exists it is skipped, not crash-looped.
# Logs: journalctl -u mycity-api-prod

[Unit]
Description=MyCity API (production)
After=network-online.target postgresql.service redis-server.service
ConditionPathExists=/srv/mycity/prod/current
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=mycity-prod
Group=mycity-prod
WorkingDirectory=/srv/mycity/prod/current
EnvironmentFile=/srv/mycity/prod/shared/.env
# The release's own BUILD_SHA and BUILD_TIME (scripts/deploy/release-manifest.js).
EnvironmentFile=-/srv/mycity/prod/current/BUILD.env
Environment=MYCITY_PROCESS=mycity-api
# Chromium writes its profile and crash database under HOME; the private /tmp is the
# only writable place besides the media root.
Environment=HOME=/tmp XDG_CONFIG_HOME=/tmp/.config XDG_CACHE_HOME=/tmp/.cache
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=40
LimitNOFILE=65536
SyslogIdentifier=mycity-api-prod

# This environment can read its release and write only its own media. It cannot read the
# other environment's directory (mode 750, another group) or anyone's home.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mycity/prod/media
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
