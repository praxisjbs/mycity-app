# MyCity App · staging environment, /srv/mycity/stg/shared/.env (owner root, group mycity-stg, 640).
#
# Written once by ops/provision/provision.sh from ops/systemd/stg.env.template; never overwritten,
# so values filled in by hand survive a re-run. Passwords, keys and secrets were generated
# on the server (copies in /root/mycity-secrets/); nothing secret is in the repository.
# Every setting is described in .env.example. Fill the lines marked FILL before the first
# deploy: the app refuses to boot on staging without SMTP (config/env.js).

APP_ENV=staging
NODE_ENV=production
PORT=7100
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

STAFF_ORIGIN=https://hub.staging.mycityapp.io
PUBLIC_ORIGIN=https://go.staging.mycityapp.io

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mycity_stg
DB_USER=mycity_stg_app
DB_PASSWORD=@@DB_PASSWORD@@
DB_SSL=false
DB_POOL_MAX=20
WORKER_DB_POOL_MAX=10

REDIS_URL=redis://:@@REDIS_PASSWORD@@@127.0.0.1:6379/1

JWT_ACCESS_SECRET=@@JWT_ACCESS_SECRET@@
JWT_REFRESH_SECRET=@@JWT_REFRESH_SECRET@@
ENCRYPTION_KEY=@@ENCRYPTION_KEY@@
METRICS_TOKEN=@@METRICS_TOKEN@@

MEDIA_ROOT=/srv/mycity/stg/media
CHROMIUM_PATH=/usr/bin/google-chrome-stable
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# FILL: system mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MyCity App <no-reply@mycityapp.io>
MAIL_REPLY_TO=

# FILL when ready: AI (empty uses the stub) and the alert channels (docs/runbooks/monitoring.md §2)
GEMINI_API_KEY=
ALERT_WEBHOOK_URL=
ALERT_WHATSAPP_URLS=
