{
  "name": "@mycity/ui",
  "version": "0.1.0",
  "private": true,
  "description": "MyCity App design system: tokens, styles and the shared components both apps import. Source only; the apps compile it.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./eslint": "./eslint.shared.js",
    "./vite": {
      "types": "./vite.shared.d.ts",
      "default": "./vite.shared.js"
    },
    "./testing": "./src/testing/index.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "vite --config gallery/vite.config.ts",
    "build": "vite build --config gallery/vite.config.ts"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.49.0",
    "react-hook-form": "7.89.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
